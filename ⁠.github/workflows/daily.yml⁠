name: Daily Stock Indicator Notification

on:
  schedule:
    # 月曜〜金曜の日本時間15:30（UTC 06:30）に自動実行
    - cron: '30 6 * * 1-5'
  workflow_dispatch: # 手動実行用ボタン

jobs:
  run-bot:
    runs-on: ubuntu-latest
    steps:
      - name: リポジトリのチェックアウト
        uses: actions/checkout@v3

      - name: Python環境のセットアップ
        uses: actions/setup-python@v4
        with:
          python-version: '3.10'

      - name: 必要なライブラリのインストール
        run: |
          pip install yfinance pandas requests

      - name: Pythonスクリプトの実行
        env:
          WEBHOOK_URL: ${{ secrets.WEBHOOK_URL }}
        run: python main.py
